{
  "mcpServers": {
    "council": {
      "type": "stdio",
      "command": "${COUNCIL_UV:-uv}",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT:-${CLAUDE_PROJECT_DIR}}",
        "council-mcp"
      ],
      "env": {
        "COUNCIL_REPO_ROOT": "${CLAUDE_PROJECT_DIR}",
        "COUNCIL_OLLAMA_URL": "${COUNCIL_OLLAMA_URL:-http://localhost:11434}"
      }
    }
  }
}
