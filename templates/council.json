{
  "version": 1,
  "max_parallel": 3,
  "budget": {
    "soft_minutes": 20,
    "hard_minutes": 25,
    "max_turns": 30
  },
  "models": {
    "local": {
      "adapter": "ollama",
      "url": "${COUNCIL_OLLAMA_URL}",
      "model": "qwen3-coder:30b",
      "num_ctx": 32768,
      "max_parallel": 1,
      "roles": [
        "implement",
        "review",
        "data",
        "docs",
        "chores"
      ],
      "privacy": [
        "public",
        "internal",
        "local-only"
      ]
    },
    "gemini": {
      "adapter": "gemini",
      "cmd": "gemini",
      "max_parallel": 2,
      "roles": [
        "implement",
        "docs",
        "assets",
        "review"
      ],
      "privacy": [
        "public"
      ],
      "enabled": false
    },
    "codex": {
      "adapter": "codex",
      "cmd": "codex",
      "max_parallel": 2,
      "roles": [
        "implement",
        "refactor",
        "assets",
        "review"
      ],
      "privacy": [
        "public"
      ]
    },
    "grok": {
      "adapter": "grok",
      "mode": "cli",
      "cmd": "grok",
      "max_parallel": 1,
      "roles": [
        "implement",
        "review",
        "assets"
      ],
      "privacy": [
        "public"
      ],
      "enabled": true
    },
    "cheap": {
      "adapter": "claude-sub",
      "cmd": "claude",
      "model": "haiku",
      "max_parallel": 2,
      "roles": [
        "chores",
        "docs"
      ],
      "privacy": [
        "public",
        "internal"
      ]
    },
    "copilot": {
      "adapter": "copilot",
      "cmd": "copilot",
      "max_parallel": 2,
      "roles": [
        "implement",
        "refactor",
        "docs",
        "assets",
        "review",
        "chores"
      ],
      "privacy": [
        "public"
      ]
    },
    "antigravity": {
      "adapter": "antigravity",
      "cmd": "agy",
      "model": "gemini-3.8-flash-high",
      "max_parallel": 2,
      "roles": [
        "implement",
        "refactor",
        "docs",
        "assets",
        "review",
        "chores"
      ],
      "privacy": [
        "public"
      ]
    }
  },
  "routing": {
    "by_privacy": {
      "local-only": [
        "local"
      ],
      "internal": [
        "local",
        "cheap"
      ],
      "public": [
        "codex",
        "antigravity",
        "copilot",
        "gemini",
        "grok",
        "cheap",
        "local"
      ]
    },
    "by_role": {
      "implement": [
        "codex",
        "antigravity",
        "copilot",
        "gemini",
        "local",
        "grok"
      ],
      "refactor": [
        "codex",
        "antigravity",
        "copilot"
      ],
      "assets": [
        "codex",
        "antigravity",
        "gemini",
        "copilot",
        "grok"
      ],
      "docs": [
        "copilot",
        "antigravity",
        "gemini",
        "cheap",
        "local"
      ],
      "review": [
        "local",
        "antigravity",
        "copilot",
        "codex",
        "gemini",
        "grok"
      ],
      "chores": [
        "local",
        "cheap",
        "antigravity",
        "copilot"
      ],
      "data": [
        "local"
      ]
    },
    "second_opinion": [
      "local",
      "antigravity",
      "copilot",
      "codex",
      "gemini",
      "grok"
    ]
  },
  "never_share": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.p12",
    "*.sql",
    "*.dump",
    "*.bak",
    "secrets/**"
  ],
  "memory_file": ".council/MEMORY.md",
  "gates": {
    "before_review": [],
    "after_merge": []
  },
  "obsidian": {
    "vault": null,
    "folder": "Council",
    "mirror": true,
    "read_context": []
  }
}
