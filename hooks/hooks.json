{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${COUNCIL_UV:-uv} run --directory \"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_PROJECT_DIR}}\" council events --root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${COUNCIL_UV:-uv} run --directory \"${CLAUDE_PLUGIN_ROOT:-${CLAUDE_PROJECT_DIR}}\" council session-start --root \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 60,
            "statusMessage": "council: checking executors"
          }
        ]
      }
    ]
  }
}
